# acore-qr — catálogo de variables (sin valores reales)
# Copia a .env solo lo que necesite cada entorno. Nunca versionar secretos.

# ---- API base ----
NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0
LOG_LEVEL=debug
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=64kb

# ---- QR (defectos; el límite de producto es 500 caracteres) ----
QR_DEFAULT_ECC=medium
QR_DEFAULT_SIZE=1024
QR_MIN_SIZE=128
QR_MAX_SIZE=4096
QR_DEFAULT_MARGIN=4
QR_MAX_TEXT_LENGTH=500
QR_ENABLE_SERVER_PNG=true
QR_ENABLE_LOGO=true

# ---- Rate limit (aplican desde Fase 02) ----
RATE_LIMIT_VALIDATE_PER_MINUTE=120
RATE_LIMIT_RENDER_PER_MINUTE=60
RATE_LIMIT_PNG_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_15_MINUTES=10

# ---- Archivos (desde Fase 05) ----
# FILE_UPLOAD_ENABLED=false desactiva la subida (p. ej. producción sin text/plain)
FILE_UPLOAD_ENABLED=true
FILE_MAX_BYTES=10485760
FILE_ALLOWED_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain
FILE_ANONYMOUS_TTL_HOURS=168
FILE_TEMP_DIR=/tmp/acore-qr
FILE_STORAGE_DRIVER=local
FILE_PUBLIC_BASE_URL=http://localhost:4000
FILE_RATE_LIMIT_UPLOAD_PER_HOUR=10
FILE_RATE_LIMIT_DOWNLOAD_PER_MINUTE=120
FILE_CLEANUP_INTERVAL_MINUTES=60

# ---- Sesiones (desde Fase 07; SESSION_SECRET_CURRENT obligatorio con
# DYNAMIC_QR_ENABLED=true; PREVIOUS habilita rotación sin invalidar sesiones) ----
SESSION_COOKIE_NAME=qr_session
SESSION_TTL_HOURS=168
SESSION_SECRET_CURRENT=
SESSION_SECRET_PREVIOUS=

# ---- Contraseñas (scrypt versionado; los parámetros se guardan con el hash) ----
PASSWORD_SCRYPT_N=16384
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1

# ---- Base de datos (desde Fase 06; obligatoria si DYNAMIC_QR_ENABLED=true) ----
DATABASE_URL=postgres://localhost:5432/acore_qr
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ---- Dinámicos (desde Fase 06; auth por sesión desde Fase 07) ----
DYNAMIC_QR_ENABLED=false
SHORT_DOMAIN=http://localhost:4000
DYNAMIC_SLUG_LENGTH=10
REDIRECT_CACHE_TTL_SECONDS=30
RATE_LIMIT_DQR_CREATE_PER_MINUTE=20
RATE_LIMIT_DQR_READ_PER_MINUTE=60
RATE_LIMIT_REDIRECT_PER_MINUTE=600
ANALYTICS_ENABLED=false

# ---- Web (solo públicas; nunca secretos con prefijo VITE_) ----
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=acore-qr
VITE_FILE_UPLOAD_ENABLED=true
VITE_DYNAMIC_QR_ENABLED=false
