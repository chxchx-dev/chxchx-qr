{
  "name": "@chxchx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API local que valida y genera QR estáticos en SVG, PNG y GIF.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage"
  },
  "dependencies": {
    "@chxchx/config": "*",
    "@chxchx/contracts": "*",
    "@chxchx/qr-core": "*",
    "express": "^5.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
