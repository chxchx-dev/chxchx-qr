# API generadora de QR estáticos
NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=32kb

# Límites por IP y minuto; PNG consume más CPU que SVG y GIF.
RATE_LIMIT_VALIDATE_PER_MINUTE=120
RATE_LIMIT_RENDER_PER_MINUTE=60
RATE_LIMIT_PNG_PER_MINUTE=20
