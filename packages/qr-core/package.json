{
  "name": "@chxchx/qr-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor local de contenido y matrices QR; la API gestiona el renderizado final.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage"
  },
  "dependencies": {
    "@chxchx/contracts": "*",
    "jsqr": "^1.4.0",
    "qr": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
